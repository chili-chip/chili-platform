{
  "name": "chili-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Wrangler scripts for the Chili Platform Django Worker.",
  "scripts": {
    "dev": "uv run pywrangler dev",
    "start": "uv run pywrangler dev",
    "deploy": "uv run pywrangler deploy",
    "types": "uv run pywrangler types",
    "migrate:local": "uv run python src/manage.py migrate",
    "seed:local": "uv run python src/manage.py seed_forum",
    "collectstatic": "WORKERS_CI=1 uv run python src/manage.py collectstatic --noinput",
    "docs": "python3 scripts/serve-docs.py"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
