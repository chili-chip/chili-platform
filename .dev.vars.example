DJANGO_SECRET_KEY=chili-platform-dev-secret-change-me
DJANGO_DEBUG=true
# Expose POST /mcp/ for Cursor and other MCP clients during npm run dev
MCP_ENABLED=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
OPS_TOKEN=chili-dev-ops-token
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=chili-dev-admin
MEDIA_URL=/media/
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STORE_CURRENCY=usd
STORE_CHECKOUT_SUCCESS_URL=http://localhost:4200/store/checkout/success?session_id={CHECKOUT_SESSION_ID}
STORE_CHECKOUT_CANCEL_URL=http://localhost:4200/store/checkout/cancel
STORE_SHIPPING_COUNTRIES=US,CA,GB,DE,FR,NL,PL,AU
# Card-processing estimate for creator credit. Set both from
# https://stripe.com/pricing for the charge currency and method.
# Basis points (1% = 100) plus a fixed amount in cents. No default.
MARKETPLACE_PROCESSING_FEE_BPS=
MARKETPLACE_PROCESSING_FEE_FIXED_CENTS=
